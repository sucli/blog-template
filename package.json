{
  "name": "paperwind-blog-template",
  "version": "1.1.0",
  "private": true,
  "description": "Paperwind — 专注内容、速度与可部署性的 Astro 开源博客模板",
  "license": "MIT",
  "author": "Paperwind contributors",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sucli/blog-template.git"
  },
  "homepage": "https://github.com/sucli/blog-template#readme",
  "bugs": {
    "url": "https://github.com/sucli/blog-template/issues"
  },
  "keywords": [
    "astro",
    "blog",
    "template",
    "markdown",
    "mdx",
    "typescript",
    "static-site"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "init": "node scripts/init-blog.mjs",
    "build": "npm run check:assets && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:assets": "node scripts/check-assets.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "vitest run",
    "index:search": "node scripts/index-search.mjs",
    "validate": "npm run test && npm run build && npm run index:search && npm run check:links"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "marked": "^18.0.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "parse5": "^8.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
