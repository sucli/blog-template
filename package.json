{
  "name": "paperwind-blog-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "init": "node scripts/init-blog.mjs",
    "build": "npm run check:assets && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:assets": "node scripts/check-assets.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "vitest run",
