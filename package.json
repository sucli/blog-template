    "validate": "npm run test && npm run build && npm run index:search && npm run check:links"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "parse5": "^8.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
