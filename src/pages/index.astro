---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { SITE, withBase } from '../config';
import { visiblePosts } from '../utils/posts';

const posts = visiblePosts(await getCollection('posts'));
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const latest = posts.filter((post) => post.id !== featured?.id).slice(0, 6);
---

<BaseLayout>
  <section class="hero container">
    <p class="eyebrow">Independent writing · 独立写作</p>
    <h1>把复杂的世界，<br /><em>写得更清楚。</em></h1>
    <p class="hero-copy">{SITE.description} 分享值得反复阅读的技术实践、设计观察与生活片段。</p>
    <div class="hero-actions">
      <a class="button" href={withBase('/posts')}>开始阅读 <Icon name="arrow" /></a>
      <a class="button secondary" href={withBase('/rss.xml')}><Icon name="rss" /> RSS 订阅</a>
    </div>
  </section>

  {featured && (
    <section class="container featured-section">
      <div class="section-heading"><p class="eyebrow">Featured story</p><span>编辑精选</span></div>
      <PostCard post={featured} featured />
    </section>
  )}

  <section class="container latest-section">
    <div class="section-heading row">
      <div><p class="eyebrow">Latest notes</p><h2>最近更新</h2></div>
      <a href={withBase('/posts')}>查看全部 <span>→</span></a>
    </div>
    {latest.length ? <div class="post-grid">{latest.map((post) => <PostCard post={post} />)}</div> : <div class="empty-state">还没有更多文章。</div>}
  </section>

  <section class="container newsletter">
    <div><p class="eyebrow">Keep in touch</p><h2>不错过下一篇文章</h2><p>使用你喜欢的 RSS 阅读器，安静地接收更新，没有算法，也没有垃圾邮件。</p></div>
    <a class="button" href={withBase('/rss.xml')}><Icon name="rss" /> 订阅 RSS</a>
  </section>
</BaseLayout>

<style>
  .hero { padding-top: clamp(76px, 12vw, 150px); padding-bottom: clamp(90px, 14vw, 170px); }
  .hero h1 { margin: 0; max-width: 900px; font-size: clamp(3.6rem, 10vw, 8.3rem); line-height: .92; letter-spacing: -.075em; }
  .hero h1 em { color: var(--accent); font-family: Georgia, 'Noto Serif SC', serif; font-weight: 400; }
  .hero-copy { max-width: 620px; margin: 30px 0 0; color: var(--muted); font-size: clamp(1rem, 2vw, 1.15rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
  .featured-section, .latest-section { padding-bottom: 120px; }
  .section-heading { margin-bottom: 28px; }
  .section-heading p { margin-bottom: 3px; }
  .section-heading span { color: var(--muted); font-size: .9rem; }
  .section-heading.row { display: flex; align-items: end; justify-content: space-between; gap: 20px; }
  .section-heading h2 { margin: 0; font-size: clamp(2rem, 5vw, 3.4rem); letter-spacing: -.05em; }
  .section-heading.row > a { color: var(--muted); font-size: .9rem; }
  .section-heading.row > a:hover { color: var(--accent); }
  .post-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px 28px; }
  .newsletter { display: flex; align-items: center; justify-content: space-between; gap: 30px; border: 1px solid var(--line); border-radius: 30px; padding: clamp(28px, 5vw, 56px); background: var(--surface); box-shadow: var(--shadow); }
  .newsletter h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 3rem); letter-spacing: -.045em; }
  .newsletter p:not(.eyebrow) { max-width: 590px; margin: 8px 0 0; color: var(--muted); }
  .newsletter .button { flex: none; }
  @media (max-width: 820px) { .post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .hero h1 { font-size: clamp(3.25rem, 17vw, 5.4rem); }
    .post-grid { grid-template-columns: 1fr; }
    .newsletter { align-items: flex-start; flex-direction: column; }
  }
</style>
