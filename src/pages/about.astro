---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ABOUT, SITE } from '../config';

function fill(text: string) {
  return text.replaceAll('{title}', SITE.title).replaceAll('{author}', SITE.author);
}

const intro = fill(ABOUT.intro);
---

<BaseLayout title="关于" description={`关于 ${SITE.author} 与这个博客。`}>
  <div class="container about-grid">
    <header class="page-heading"><p class="eyebrow">About this place</p><h1>你好，我是<br />{SITE.author}。</h1></header>
    <div class="prose about-copy">
      <p>{intro}</p>
      {ABOUT.sections.map((section) => {
        const body = fill(section.body);
        const [beforeEmail = body, afterEmail = ''] = body.includes('{email}') ? body.split('{email}') : [body];
        return (
          <>
            <h2>{section.title}</h2>
            <p>
              {beforeEmail}
              {body.includes('{email}') && <a href={`mailto:${SITE.email}`}>{SITE.email}</a>}
              {afterEmail}
            </p>
          </>
        );
      })}
      <p><em>提示：在 <code>site.config.json</code> 的 <code>about</code> 字段中替换这些示例文字。正文支持 <code>{'{title}'}</code>、<code>{'{author}'}</code> 与 <code>{'{email}'}</code> 占位符。</em></p>
    </div>
  </div>
</BaseLayout>

<style>
  .about-grid { display: grid; grid-template-columns: minmax(280px, .8fr) minmax(0, 1fr); gap: clamp(40px, 10vw, 130px); padding-top: 50px; }
  .page-heading { padding-top: 20px; }
  .page-heading h1 { font-size: clamp(3rem, 7vw, 5.3rem); }
  .about-copy { margin: 0; padding-top: 30px; }
  @media (max-width: 760px) { .about-grid { grid-template-columns: 1fr; gap: 0; } .about-copy { padding-top: 0; } }
</style>
