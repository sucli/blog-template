---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, withBase } from '../config';
const searchIndexUrl = withBase('/search-index.json');
---

<BaseLayout title="搜索" description="搜索站内文章。" noindex>
  <div class="container search-wrap" data-index-url={searchIndexUrl} data-locale={SITE.locale}>
    <header class="page-heading"><p class="eyebrow">Find a story</p><h1>搜索</h1><p>输入标题、摘要或标签。</p></header>
    <label class="search-box">
      <span class="visually-hidden">搜索文章</span>
      <Icon name="search" />
      <input id="search-input" type="search" placeholder="例如：Astro、部署、写作…" autocomplete="off" autofocus />
      <kbd aria-hidden="true">⌘ K</kbd>
    </label>
    <p id="search-count" class="count" aria-live="polite" aria-atomic="true">正在加载文章…</p>
    <div id="search-results" class="results"></div>
    <div id="search-empty" class="empty-state" hidden>没有找到相关文章，换个关键词试试。</div>
  </div>
</BaseLayout>

<style>
  .search-wrap { max-width: 860px; }
  .search-box { display: flex; align-items: center; gap: 12px; border: 1px solid var(--line); border-radius: 16px; padding: 0 18px; background: var(--surface); box-shadow: var(--shadow); }
  .search-box:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft), var(--shadow); }
  .search-box input { width: 100%; border: 0; outline: 0; padding: 17px 0; color: var(--text); background: transparent; }
  .search-box kbd { border: 1px solid var(--line); border-radius: 6px; padding: 2px 7px; color: var(--muted); background: var(--surface-soft); font-size: .72rem; white-space: nowrap; }
  .count { margin: 20px 2px; color: var(--muted); font-size: .82rem; }
  .results { border-top: 1px solid var(--line); }
  :global(.search-result) { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 25px 4px; border-bottom: 1px solid var(--line); }
  :global(.search-result time) { color: var(--muted); font-size: .78rem; }
  :global(.search-result h2) { margin: 4px 0; font-size: 1.25rem; letter-spacing: -.025em; }
  :global(.search-result h2 a:hover) { color: var(--accent); }
  :global(.search-result p) { margin: 0; color: var(--muted); font-size: .88rem; }
  :global(.search-result > span) { color: var(--muted); }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const wrapper = document.querySelector<HTMLElement>('.search-wrap');
  const results = document.querySelector<HTMLElement>('#search-results');
  const count = document.querySelector<HTMLElement>('#search-count');
  const empty = document.querySelector<HTMLElement>('#search-empty');
  interface SearchPost { title: string; description: string; date: string; href: string; search: string }
  let posts: SearchPost[] = [];
  const locale = wrapper?.dataset.locale;

  const createResult = (post: SearchPost) => {
    const article = document.createElement('article');
    article.className = 'search-result';
    const content = document.createElement('div');
    const time = document.createElement('time');
    const heading = document.createElement('h2');
    const link = document.createElement('a');
    const description = document.createElement('p');
    const arrow = document.createElement('span');
    time.textContent = post.date;
    link.href = post.href;
    link.textContent = post.title;
    description.textContent = post.description;
    arrow.textContent = '→';
    heading.append(link);
    content.append(time, heading, description);
    article.append(content, arrow);
    return article;
  };

  const update = () => {
    const query = input?.value.trim().toLocaleLowerCase(locale) ?? '';
    const matches = posts.filter((post) => !query || post.search.includes(query));
    results?.replaceChildren(...matches.map(createResult));
    const visible = matches.length;
    if (count) count.textContent = query ? `找到 ${visible} 篇文章` : `共 ${visible} 篇文章`;
    if (empty) empty.hidden = visible !== 0;
  };

  const load = async () => {
    try {
      const response = await fetch(wrapper?.dataset.indexUrl ?? '');
      if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);
      posts = await response.json();
      update();
    } catch (error) {
      console.error(error);
      if (count) count.textContent = '搜索索引加载失败';
    }
  };

  input?.addEventListener('input', update);
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      input?.focus();
    }
  });
  load();
</script>
