---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatMonthDay, visiblePosts } from '../utils/posts';
import { withBase } from '../config';

const posts = visiblePosts(await getCollection('posts'));
const groups = Object.entries(Object.groupBy(posts, (post) => String(post.data.pubDate.getUTCFullYear())))
  .sort(([a], [b]) => Number(b) - Number(a));
---

<BaseLayout title="归档" description="按年份浏览所有文章。">
  <div class="container archive-wrap">
    <header class="page-heading"><p class="eyebrow">From the archive</p><h1>归档</h1><p>所有文章，按发布时间整理。</p></header>
    <div class="archive">
      {groups.map(([year, yearPosts]) => (
        <section>
          <h2>{year}</h2>
          <div class="year-posts">
            {yearPosts?.map((post) => (
              <a href={withBase(`/posts/${post.id}`)}>
                <time datetime={post.data.pubDate.toISOString()}>{formatMonthDay(post.data.pubDate)}</time>
                <strong>{post.data.title}</strong>
                <span>→</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .archive-wrap { max-width: 900px; }
  .archive { display: grid; gap: 54px; }
  section { display: grid; grid-template-columns: 120px 1fr; gap: 30px; }
  h2 { margin: 8px 0 0; color: var(--accent); font: 400 2rem Georgia, serif; }
  .year-posts { border-top: 1px solid var(--line); }
  .year-posts a { display: grid; grid-template-columns: 100px 1fr auto; align-items: center; gap: 18px; padding: 20px 4px; border-bottom: 1px solid var(--line); }
  .year-posts a:hover strong, .year-posts a:hover span { color: var(--accent); }
  time { color: var(--muted); font-size: .82rem; }
  strong { font-size: 1rem; }
  span { color: var(--muted); }
  @media (max-width: 620px) {
    section { grid-template-columns: 1fr; gap: 10px; }
    .year-posts a { grid-template-columns: 76px 1fr auto; gap: 10px; }
  }
</style>
