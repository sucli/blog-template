---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../config';
---

<BaseLayout title="页面未找到">
  <section class="container not-found">
    <p class="code">404</p><h1>这页被风吹走了。</h1><p>你访问的页面不存在，或者已经更换了地址。</p><a class="button" href={withBase('/')}>返回首页</a>
  </section>
</BaseLayout>

<style>
  .not-found { display: grid; place-items: center; min-height: 65vh; padding: 60px 0; text-align: center; }
  .code { margin: 0; color: var(--accent); font: 400 clamp(5rem, 20vw, 12rem) Georgia, serif; line-height: .8; }
  h1 { margin: 16px 0 8px; font-size: clamp(2rem, 6vw, 4rem); letter-spacing: -.05em; }
  .not-found > p:not(.code) { margin: 0 0 25px; color: var(--muted); }
</style>
