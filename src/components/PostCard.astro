---
import type { Post } from '../utils/posts';
import { formatDate, getReadingTime, tagToSlug } from '../utils/posts';
import { withBase } from '../config';

interface Props { post: Post; featured?: boolean }
const { post, featured = false } = Astro.props;
const cover = post.data.cover ? withBase(post.data.cover) : undefined;
---

<article class:list={['post-card', { featured }]}>
  <a class="cover" href={withBase(`/posts/${post.id}`)} aria-label={`阅读《${post.data.title}》`}>
    {cover ? <img src={cover} alt={post.data.coverAlt ?? ''} width="1200" height="760" loading={featured ? 'eager' : 'lazy'} decoding="async" /> : <span class="cover-letter">{post.data.title.slice(0, 1)}</span>}
  </a>
  <div class="content">
    <div class="meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span>·</span>
      <span>{getReadingTime(post)} 分钟阅读</span>
    </div>
    <h2><a href={withBase(`/posts/${post.id}`)}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <div class="tags">
      {post.data.tags.slice(0, 3).map((tag) => <a class="pill" href={withBase(`/tags/${tagToSlug(tag)}`)}>#{tag}</a>)}
    </div>
  </div>
</article>

<style>
  .post-card { display: flex; flex-direction: column; min-width: 0; }
  .cover { position: relative; overflow: hidden; aspect-ratio: 16 / 10; border-radius: var(--radius); background: var(--accent-soft); box-shadow: var(--shadow); }
  .cover::after { content: ''; position: absolute; inset: 0; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 15%); border-radius: inherit; pointer-events: none; }
  .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s cubic-bezier(.2,.8,.2,1); }
  .cover:hover img { transform: scale(1.035); }
  .cover-letter { display: grid; place-items: center; width: 100%; height: 100%; color: var(--accent); font: 700 clamp(4rem, 10vw, 7rem) Georgia, serif; }
  .content { padding: 22px 4px 0; }
  .meta { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; color: var(--muted); font-size: .78rem; }
  h2 { margin: 10px 0 8px; font-size: 1.35rem; line-height: 1.3; letter-spacing: -.03em; }
  h2 a:hover { color: var(--accent); }
  p { margin: 0 0 17px; color: var(--muted); font-size: .92rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 7px; }
  .featured { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(260px, 1fr); align-items: center; gap: clamp(28px, 6vw, 72px); }
  .featured .cover { aspect-ratio: 16 / 11; }
  .featured .content { padding: 0; }
  .featured h2 { font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.12; }
  .featured p { font-size: 1rem; }
  @media (max-width: 760px) {
    .featured { display: flex; }
    .featured .content { padding: 22px 4px 0; }
  }
</style>
